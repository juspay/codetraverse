{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "es2015",
    "moduleResolution": "node",
    "sourceMap": true,
    "declaration": true,
    "outDir": "./dist",
    "downlevelIteration": true,
    "skipLibCheck": true,
    "baseUrl": "./codetraverse",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "codetraverse/**/*",
    "codetraverse/test_orchestrator.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
