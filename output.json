            "sendStatusResponse :: API.GetStatus -> Either String Types.SetuSyncApiresponse -> L.Flow API.GetStatusResponse\nsendStatusResponse request gatewayResponse = case gatewayResponse of\n  Right (Types.SetuCollectTxnSyncResponse txnSyncResponse) -> do\n    let (errorCode, errorMessage) = getErrorCodeAndErrorMessagefromReason txnSyncResponse.reason\n        pgr        = extractPGResponse errorCode errorMessage (Utils.toTextResponse txnSyncResponse) (Utils.getDefaultPaymentGatewayResponse request.txnDetail)\n        txnStatus  = mandateSyncGatewayResponseCode txnSyncResponse.status request.txnDetail\n        gsmDetails = gsmLookupDetails errorCode errorMessage request\n    pure $ makeGetStatusResponse txnStatus pgr gsmDetails\n  Right (Types.SetuIntentTxnSyncResponse txnSyncResponse) -> do\n    let (errorCode, errorMessage) = getErrorCodeAndErrorMessagefromReason txnSyncResponse.reason\n        pgr        = extractPGResponse errorCode errorMessage (Utils.toTextResponse txnSyncResponse) (Utils.getDefaultPaymentGatewayResponse request.txnDetail)\n        txnStatus  = mandateSyncGatewayResponseCode txnSyncResponse.status request.txnDetail\n        gsmDetails = gsmLookupDetails errorCode errorMessage request\n    pure $ makeGetStatusResponse txnStatus pgr gsmDetails\n  Right (Types.SetuMandateTxnSyncResponse txnSyncResponse) -> do\n    let (errorCode, errorMessage) = getErrorCodeAndErrorMessagefromReason txnSyncResponse.reason\n        pgr        = extractPGResponse errorCode errorMessage (Utils.toTextResponse txnSyncResponse) (Utils.getDefaultPaymentGatewayResponse request.txnDetail)\n        txnStatus  = mandateSyncGatewayResponseCode txnSyncResponse.status request.txnDetail\n        gsmDetails = gsmLookupDetails errorCode errorMessage request\n    pure $ makeGetStatusResponse txnStatus pgr gsmDetails\n  Right (Types.SetuMandateExecuteTxnSyncResponse txnSyncResponse) -> do\n    let (errorCode, errorMessage) = getErrorCodeAndErrorMessagefromReason txnSyncResponse.reason\n        pgr        = extractPGResponse errorCode errorMessage (Utils.toTextResponse txnSyncResponse) (Utils.getDefaultPaymentGatewayResponse request.txnDetail)\n        txnStatus  = mandateSyncGatewayResponseCode txnSyncResponse.status request.txnDetail\n        gsmDetails = gsmLookupDetails errorCode errorMessage request\n    pure $ makeGetStatusResponse txnStatus pgr gsmDetails\n  Right (Types.SetuSyncApiErrorResponse txnSyncResponse) -> do\n    let (errorCode, errorMessage) = (txnSyncResponse.code, txnSyncResponse.detail)\n        pgr        = extractPGResponse errorCode errorMessage (Utils.toTextResponse txnSyncResponse) (Utils.getDefaultPaymentGatewayResponse request.txnDetail)\n        gsmDetails = gsmLookupDetails errorCode errorMessage request\n    pure $ makeGetStatusResponse TxnDetail.PendingVBV pgr gsmDetails\n  Left errorResp ->\n    L.logErrorT EWE.INVALID_GATEWAY_RESPONSE \"INVALID_PG_RESPONSE\" (T.pack errorResp) $>\n      makeGetStatusResponse request.txnDetail.status (Utils.getDefaultPaymentGatewayResponse request.txnDetail) Nothing\n\n  where\n    makeGetStatusResponse txnStatus pgr gsmDetails =\n      API.GetStatusResponse\n        { isPaymentSuccessful    = (txnStatus == TxnDetail.Charged)\n        , didAuthenticationFail  = (txnStatus == TxnDetail.AuthenticationFailed)\n        , isAuthorized           = (txnStatus == TxnDetail.Authorized)\n        , isPendingTransaction   = (txnStatus == TxnDetail.PendingVBV)\n        , isTxnNotFound          = False\n        , pgrResponse            = Domain.PaymentGatewayResponse pgr\n        , isPGRUpdated           = False\n        , shouldUpdateAsPreauth  = False\n        , preAuthStatus          = Nothing\n        , gsmLookupDetails       = gsmDetails\n        , threeDSVersion         = Nothing\n        , isUpiCredit            = Nothing\n        , purposeStatus          = Nothing\n        , gatewayInfoParams      = Nothing\n        , isTpvValidated         = Nothing\n        }\n\n    getErrorCodeAndErrorMessagefromReason reason = case reason of\n      Just reasonDetail -> (fromMaybe (fromMaybe \"\" reasonDetail.npciErrCode) reasonDetail.npciRespCode, fromMaybe \"\" reasonDetail.desc)\n      Nothing           -> (\"\", \"\")\n    \n    gsmLookupDetails errorCode errorMessage req =\n      Just $ API.GSMLookupDetails\n        { gatewayResponseCode    = errorCode\n        , gatewayResponseMessage = errorMessage\n        , sourceSubType          = Utils.getSourceSubType req.txnDetail\n        }",
