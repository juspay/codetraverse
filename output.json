            "callBrowserInfoAPI",
            "callBrowserInfoAPI :: Types.IntermediateRequest -> Bool -> () -> Types.NgeniusAccountDetails -> Types.SendBrowserInfoRequest -> Text -> L.Flow (Either Types.GenericErrorMessage (Either Client.ClientError Types.NgeniusFinalTransactionApiResponse))\ncallBrowserInfoAPI request isSandbox _ accDetails reqBody authToken = do\n  case request.originalRequest.txnCardInfo.paymentMethod == \"APPLEPAY\" of\n    True -> pure $ Right $ Right $ Types.ApplePayResponse () -- Apple Pay does not require browser info\n    False -> do\n      case (request.paymentId, request.orderId) of\n        (Nothing, _) ->\n          pure $ Left $ fromMaybe Types.GenericErrorMessage {code = \"PAYMENT_ID_NOT_FOUND\", message = \"Payment Id not found\", response = Nothing, status = Just Types.PG_ERROR} request.genericError\n        (_, Nothing) ->\n          pure $ Left $ fromMaybe Types.GenericErrorMessage {code = \"ORDER_ID_NOT_FOUND\", message = \"Order Id not found\", response = Nothing, status = Just Types.PG_ERROR} request.genericError\n        (Just pid, Just oid) -> do\n          txnRequestBody <- Transforms.makeRequestInitiateTransaction request.originalRequest\n          case txnRequestBody of\n            Left err -> pure $ Left err\n            Right txnReqBody -> do\n              txnResp <- Routes.initInitiateTransactionCall accDetails.outletReference oid pid (Transforms.makeBearerAuthHeader authToken) txnReqBody isSandbox request.originalRequest.merchantGatewayAccount request.originalRequest.txnDetail\n              case txnResp of\n                Right resp -> do\n                  browserInfoResp <- Routes.sendBrowserInfoCall accDetails.outletReference oid resp.reference (Transforms.makeBearerAuthHeader authToken) reqBody isSandbox request.originalRequest.merchantGatewayAccount request.originalRequest.txnDetail\n                  case browserInfoResp of\n                    Right r -> pure $ Right $ Right $ Types.CardResponse r\n                    Left err -> pure $ Right $ Left err\n\n                Left err@(S.FailureResponse _ res)  ->\n                  case A.eitherDecode $ S.responseBody res of\n                    Right (failResp :: Types.NgeniusErrorResponse) -> do\n                      let mErrors = failResp.errors >>= listToMaybe\n                          code    = (mErrors >>= (\\x -> Just x.errorCode))\n                          msg     = fromMaybe failResp.message (mErrors >>= (\\x -> Just x.localizedMessage))\n                      pure $ Left $ Types.GenericErrorMessage {code = TL.fromStrict $ fromMaybe \"CLIENT_ERROR\" code, message = TL.fromStrict msg, response = Nothing, status = Just Types.PG_ERROR}\n                    Left  _ ->  pure $ Left $ Types.GenericErrorMessage {code = TL.fromStrict \"CLIENT_ERROR\", message = TL.fromStrict \"Error while sending Card data to the gateway\", response = Nothing, status = Just Types.PG_ERROR}\n                Left err   -> pure $ Left $ Types.GenericErrorMessage { code = TL.fromStrict \"CLIENT_ERROR\", message = TL.fromStrict \"Error while sending Card data to the gateway\", response = Nothing, status = Just Types.PG_ERROR}",
            "callBrowserInfoAPI :: Types.IntermediateRequest -> Bool -> () -> Types.NgeniusAccountDetails -> Types.SendBrowserInfoRequest -> Text -> L.Flow (Either Types.GenericErrorMessage (Either Client.ClientError Types.NgeniusFinalTransactionApiResponse))\ncallBrowserInfoAPI request isSandbox _ accDetails reqBody authToken = do\n  case request.originalRequest.txnCardInfo.paymentMethod == \"APPLEPAY\" of\n    True -> pure $ Right $ Right $ Types.ApplePayResponse () -- Apple Pay does not require browser info\n    False -> do\n      case (request.paymentId, request.orderId) of\n        (Nothing, _) ->\n          pure $ Left $ fromMaybe Types.GenericErrorMessage {code = \"PAYMENT_ID_NOT_FOUND\", message = \"Payment Id not found\", response = Nothing, status = Just Types.PG_ERROR} request.genericError\n        (_, Nothing) ->\n          pure $ Left $ fromMaybe Types.GenericErrorMessage {code = \"ORDER_ID_NOT_FOUND\", message = \"Order Id not found\", response = Nothing, status = Just Types.PG_ERROR} request.genericError\n        (Just pid, Just oid) -> do\n          txnRequestBody <- Transforms.makeRequestInitiateTransaction request.originalRequest\n          case txnRequestBody of\n            Left err -> pure $ Left err\n            Right txnReqBody -> do\n              txnResp <- Routes.initInitiateTransactionCall accDetails.outletReference oid pid (Transforms.makeBearerAuthHeader authToken) txnReqBody isSandbox request.originalRequest.merchantGatewayAccount request.originalRequest.txnDetail\n              case txnResp of\n                Right resp -> do\n                  case resp.state of\n                    \"AWAIT_3DS\" -> do\n                      browserInfoResp <- Routes.sendBrowserInfoCall accDetails.outletReference oid resp.reference (Transforms.makeBearerAuthHeader authToken) reqBody isSandbox request.originalRequest.merchantGatewayAccount request.originalRequest.txnDetail\n                      case browserInfoResp of\n                        Right r  -> pure $ Right $ Right $ Types.CardResponse r\n                        Left err -> pure $ Right $ Left err\n                    _            -> pure $ Right $ Right $ Types.Non3dsCardResponse resp\n\n                Left err@(S.FailureResponse _ res)  ->\n                  case A.eitherDecode $ S.responseBody res of\n                    Right (failResp :: Types.NgeniusErrorResponse) -> do\n                      let mErrors = failResp.errors >>= listToMaybe\n                          code    = (mErrors >>= (\\x -> Just x.errorCode))\n                          msg     = fromMaybe failResp.message (mErrors >>= (\\x -> Just x.localizedMessage))\n                      pure $ Left $ Types.GenericErrorMessage {code = TL.fromStrict $ fromMaybe \"CLIENT_ERROR\" code, message = TL.fromStrict msg, response = Nothing, status = Just Types.PG_ERROR}\n                    Left  _ ->  pure $ Left $ Types.GenericErrorMessage {code = TL.fromStrict \"CLIENT_ERROR\", message = TL.fromStrict \"Error while sending Card data to the gateway\", response = Nothing, status = Just Types.PG_ERROR}\n                Left err   -> pure $ Left $ Types.GenericErrorMessage { code = TL.fromStrict \"CLIENT_ERROR\", message = TL.fromStrict \"Error while sending Card data to the gateway\", response = Nothing, status = Just Types.PG_ERROR}",
