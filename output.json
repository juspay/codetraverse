            "handleInitiateRefundSuccessResponse :: API.InitiateRefund -> Types.SetuInitiateRefundResponse -> API.RefundResponse\nhandleInitiateRefundSuccessResponse request response =\n    let refundData   = request.refund\n        refundStatus = getRefundStatusFromResponse response request.refund\n        (responseCode, responseMessage) = case response.reason of\n          Just newReason -> (newReason.npciRespCode, newReason.desc)\n          Nothing        -> (\"\", \"Awaiting PG Response.\")\n        updatedRefundData = refundData\n                { Refund.status              = refundStatus\n                , Refund.processed           = True\n                , Refund.sentToGateway       = Just True\n                , Refund.epgTransactionId    = Just $ Utils.textToEpgTxnId response.id\n                , Refund.referenceId         = Refund.RefundReferenceId <$> response.referenceId\n                , Refund.errorMessage        = Just responseMessage\n                , Refund.responseCode        = Just responseCode\n                }\n    in API.RefundResponse updatedRefundData (Utils.txnIdToText request.txnDetail.txnId) Nothing\n  where \n    getRefundStatusFromResponse :: Types.SetuInitiateRefundResponse -> Refund.Refund -> Refund.RefundStatus\n    getRefundStatusFromResponse response refund = case response.status of\n      \"success\" -> Refund.Success\n      \"failure\" -> Refund.Failure\n      \"pending\" -> Refund.Pending\n      _         -> refund.status",
