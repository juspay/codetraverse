ht $ Left err\n\n                Left err@(S.FailureResponse _ res)  ->\n                  case A.eitherDecode $ S.responseBody res of\n                    Right (failResp :: Types.NgeniusErrorResponse) -> do\n                      let mErrors = failResp.errors >>= listToMaybe\n                          code    = (mErrors >>= (\\x -> Just x.errorCode))\n                          msg     = fromMaybe failResp.message (mErrors >>= (\\x -> Just x.localizedMessage))\n                      pure $ Left $ Types.GenericErrorMessage {code = TL.fromStrict $ fromMaybe \"CLIENT_ERROR\" code, message = TL.fromStrict msg, response = Nothing, status = Just Types.PG_ERROR}\n                    Left  _ ->  pure $ Left $ Types.GenericErrorMessage {code = TL.fromStrict \"CLIENT_ERROR\", message = TL.fromStrict \"Error while sending Card data to the gateway\", response = Nothing, status = Just Types.PG_ERROR}\n                Left err   -> pure $ Left $ Types.GenericErrorMessage { code = TL.fromStrict \"CLIENT_ERROR\", message = TL.fromStrict \"Error while sending Card data to the gateway\", response = Nothing, status = Just Types.PG_ERROR}",
