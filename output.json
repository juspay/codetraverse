            "callAPISendCollect ::  API.SendCollect -> Bool -> Types.VerifiedPayload -> Types.OrangeAccountDetails -> Types.OrangeRequest -> Types.OrangeRequest -> L.Flow (Either Types.GenericErrorResponseParam (Either Text HTTPResponse))\ncallAPISendCollect _ testMode _ _ _ orangeReq = do\n  let headers = Trans.constructRequestHeaders $ Types.OrangeRequestHeaders {contentType = \"application/json\"}\n  initiateResp <- Routes.callHTTPAPI GW_INIT_COLLECT testMode headers (Just $ LBinaryString $ encode orangeReq) Types.CallInitiateAPI (Just False) False Nothing Nothing\n  case initiateResp of\n    Left clientError -> pure $ Left $ Types.GenericErrorResponseParam (Utils.makeGenericErrorResponse \"NETWORK_ERROR\" (Just \"NETWORK_ERROR\") \"Upi Collect Network Error\" (Just $ toJSON clientError)) Txn.AuthenticationFailed \n    Right apiResponse -> do\n      case eitherDecode $ apiResponse.getResponseBody.getLBinaryString of\n        Right (orangeRes :: Types.OrangeResponse) -> do\n          Right <$> Routes.callHTTPAPI GW_INIT_COLLECT testMode Map.empty Nothing Types.CallCollectS2SAPI (Just False) True orangeRes.redirectURI orangeRes.tranCtx\n        Left err -> pure $ Left $ Types.GenericErrorResponseParam (Utils.makeGenericErrorResponse \"INVALID_RESPONSE\" (Just \"INVALID_RESPONSE\") \"Collect Invalid Response from PG\" (Just $ toJSON err)) Txn.AuthenticationFailed",
